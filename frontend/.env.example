# Supabase — required at build and runtime.
# The repository instantiates Supabase clients at module load, so the build
# step needs these set even when no real backend is reachable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis — used by the document-progress queue and SSE subscriber.
# Defaults to redis://localhost:6379 when unset.
REDIS_URL=redis://localhost:6379

# Comma-separated list of cross-origin domains allowed to call /api routes.
# Unset means same-origin only.
ALLOWED_ORIGINS=
